# Configuración de cargar_datos.py.
# Para cambiar algún valor: copiar este archivo con el nombre ".env" y editarlo.
# Si no existe ".env", el programa usa exactamente estos valores.

# Carpeta con las planillas del campus (una subcarpeta por materia) y carpeta de salida.
CARPETA_DATOS=data/raw
CARPETA_SALIDA=data/processed

# Subcarpeta que tiene el padrón oficial en vez de una materia.
CARPETA_MATRICULADOS=matriculados

# Perfil del campus que se marca con es_alumno = True.
PERFIL_ALUMNO=Alumnos

# Estado del padrón que cuenta como inscripción vigente.
ESTADO_INSCRIPCION_ACTIVA=Aceptada
